# Copy to backend/.env and fill in. Never commit the real file.

# Clerk (Dashboard -> API keys). Session tokens are verified against the JWKS URL.
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
# Not read by the app today (JWKS verification needs no secret); kept for Clerk Backend API calls.
CLERK_SECRET_KEY=sk_test_...

# MongoDB Atlas. Replace <password> including the angle brackets; URL-encode special characters.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
DATABASE_NAME=Voice-Cloning-App

# Optional: comma-separated origins the frontend is served from (CORS + token azp check).
# VC_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
